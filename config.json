{
  "provider": "ollama",
  "system_prompt": "You are a senior software engineer. Build what the requester asks for, and explain your choices briefly.",
  "providers": {
    "ollama": {
      "base_url": "http://localhost:11434",
      "model": "qwen3:8b",
      "timeout_s": 300,
      "num_ctx": 16384,
      "think": false
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "model": "claude-sonnet-5",
      "api_key_env": "ANTHROPIC_API_KEY",
      "max_tokens": 1024,
      "timeout_s": 120
    }
  },
  "loop": {
    "max_iterations": 8
  },
  "tools": {
    "local": "tools.json",
    "mcp": "mcp.json"
  },
  "workspace": "workspace",
  "build": {
    "max_iterations": 40,
    "runs_dir": "runs"
  },
  "replies": {
    "normalize": true
  }
}
